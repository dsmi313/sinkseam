# hierarchical_model_linear.jags
# Bayesian hierarchical linear regression for continuous outcomes (wOBA against).
# Only plate-appearance-ending pitches are passed in.
#
# Reference category: CU (curveball).  label_sl and label_st are binary
# indicators; when both are 0 the pitch is a curveball.
#
# Confounders: batter_right (1=RHB, 0=LHB; left-handed batter is reference),
#              two_strike (1 if strike count = 2, 0 otherwise).
#
# Key estimands:
#   beta_sl        – SL vs CU effect on wOBA (controlling for movement, speed, count, handedness)
#   beta_st        – ST vs CU effect on wOBA (controlling for movement, speed, count, handedness)
#   beta_st_vs_sl  – derived contrast: ST vs SL
#
# Priors: weakly informative N(0, 1) for all fixed effects (Gelman et al. 2008);
# Gamma(0.001, 0.001) for precision parameters.

model {
  for (i in 1:N) {
    Y[i] ~ dnorm(mu[i], tau)

    mu[i] <- alpha[pitcher_id[i]] +
              beta_pfx_x   * pfx_x_z[i]      +
              beta_pfx_z   * pfx_z_z[i]      +
              beta_speed   * speed_z[i]       +
              beta_R       * batter_right[i]  +
              beta_2strike * two_strike[i]    +
              beta_sl      * label_sl[i]      +
              beta_st      * label_st[i]
  }

  # Derived contrast: sweeper vs. slider
  beta_st_vs_sl <- beta_st - beta_sl

  tau ~ dgamma(0.001, 0.001)

  for (j in 1:J) {
    alpha[j] ~ dnorm(mu_alpha, tau_alpha)
  }

  mu_alpha  ~ dnorm(0, 0.001)
  tau_alpha ~ dgamma(0.001, 0.001)

  beta_pfx_x   ~ dnorm(0, 1)
  beta_pfx_z   ~ dnorm(0, 1)
  beta_speed   ~ dnorm(0, 1)
  beta_R       ~ dnorm(0, 1)
  beta_2strike ~ dnorm(0, 1)
  beta_sl      ~ dnorm(0, 1)
  beta_st      ~ dnorm(0, 1)
}
