# hierarchical_model.jags
# Bayesian hierarchical logistic regression for binary outcomes
# (whiff, chase).
#
# Reference category: CU (curveball).  label_sl and label_st are binary
# indicators passed from R; when both are 0 the pitch is a curveball.
#
# Confounders: stand_lhb (1=LHB, 0=RHB), balls_z, strikes_z (standardized count).
#
# Key estimands:
#   beta_sl        – SL vs CU effect on log-odds (controlling for movement, speed, count, handedness)
#   beta_st        – ST vs CU effect on log-odds (controlling for movement, speed, count, handedness)
#   beta_st_vs_sl  – derived contrast: ST vs SL (= beta_st - beta_sl)
#
# Priors: weakly informative N(0, 1) on log-odds scale for all fixed effects
# (Gelman et al. 2008); Gamma(0.001, 0.001) for precision parameters.

model {
  for (i in 1:N) {
    logit(p[i]) <- alpha[pitcher_id[i]] +
                   beta_pfx_x   * pfx_x_z[i]  +
                   beta_pfx_z   * pfx_z_z[i]  +
                   beta_speed   * speed_z[i]   +
                   beta_stand   * stand_lhb[i] +
                   beta_balls   * balls_z[i]   +
                   beta_strikes * strikes_z[i] +
                   beta_sl      * label_sl[i]  +
                   beta_st      * label_st[i]

    Y[i] ~ dbern(p[i])
  }

  # Derived contrast: sweeper vs. slider
  beta_st_vs_sl <- beta_st - beta_sl

  for (j in 1:J) {
    alpha[j] ~ dnorm(mu_alpha, tau_alpha)
  }

  mu_alpha  ~ dnorm(0, 0.001)
  tau_alpha ~ dgamma(0.001, 0.001)

  beta_pfx_x   ~ dnorm(0, 1)
  beta_pfx_z   ~ dnorm(0, 1)
  beta_speed   ~ dnorm(0, 1)
  beta_stand   ~ dnorm(0, 1)
  beta_balls   ~ dnorm(0, 1)
  beta_strikes ~ dnorm(0, 1)
  beta_sl      ~ dnorm(0, 1)
  beta_st      ~ dnorm(0, 1)
}
